# 应用
APP_NAME="Trip Agents"
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# 高德地图：使用 Web 服务类型的 Key
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=10

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=trip_agents
MYSQL_PASSWORD=
MYSQL_DATABASE=trip_agents
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT_SECONDS=30
MYSQL_POOL_RECYCLE_SECONDS=1800
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_ECHO=false

# 日志：auto 在开发环境输出文本；production 始终输出 JSON
LOG_LEVEL=INFO
LOG_FORMAT=auto
LOG_FILE_ENABLED=false
LOG_DIR=logs
LOG_ROTATION="10 MB"
LOG_RETENTION="7 days"
LOG_ENQUEUE=true

# Agent 执行约束；后续创建工作流和客户端时需要传入并执行这些限制
AGENT_TIMEOUT_SECONDS=120
AGENT_RECURSION_LIMIT=30
AGENT_MAX_TOOL_CALLS=10
