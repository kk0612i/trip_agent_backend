# 应用
APP_NAME="Trip Agents"
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# 高德地图：使用 Web 服务类型的 Key
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=10
AMAP_MAX_CONCURRENCY=3
AMAP_CACHE_TTL_SECONDS=3600

# 博查搜索：可选，为空时问答只使用高德和当前草稿
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_TIMEOUT_SECONDS=15

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
# 结构化输出需要强制工具调用，思考模式默认关闭
DEEPSEEK_THINKING_ENABLED=false

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=trip_agents
MYSQL_PASSWORD=
MYSQL_DATABASE=trip_agents
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT_SECONDS=30
MYSQL_POOL_RECYCLE_SECONDS=1800
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_ECHO=false

# 认证：设置至少 32 字节的随机签名密钥，多个 worker 使用同一密钥
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=trip-agents
AUTH_JWT_AUDIENCE=trip-agents-api
AUTH_TOKEN_TTL_SECONDS=1800

# 日志：auto 在开发环境输出文本；production 始终输出 JSON
LOG_LEVEL=INFO
LOG_FORMAT=auto
LOG_FILE_ENABLED=false
LOG_DIR=logs
LOG_ROTATION="10 MB"
LOG_RETENTION="7 days"
LOG_ENQUEUE=true

# Agent 执行约束：单轮期限、根图步骤上限、问答 Agent 工具调用上限
AGENT_TIMEOUT_SECONDS=120
AGENT_RECURSION_LIMIT=30
AGENT_MAX_TOOL_CALLS=10
# 行程规划：单次 CP-SAT 求解秒数上限、单轮对话占用行程的租约秒数
TRIP_SOLVER_TIME_LIMIT_SECONDS=10
TRIP_TURN_LOCK_SECONDS=300
